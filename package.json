{
  "name": "sepp-js",
  "version": "0.1.1",
  "description": "JavaScript/TypeScript client for the sepp durable job queue",
  "license": "MIT",
  "author": "sepp-org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sepp-org/sepp-js.git"
  },
  "homepage": "https://github.com/sepp-org/sepp-js#readme",
  "bugs": {
    "url": "https://github.com/sepp-org/sepp-js/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "gen": "buf generate",
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "example": "tsx examples/main.ts",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "format:check": "biome format",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "sepp",
    "job-queue",
    "queue",
    "grpc",
    "worker",
    "task-queue"
  ],
  "dependencies": {
    "@grpc/grpc-js": "^1.12.0"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.9.0"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/api": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "@opentelemetry/sdk-trace-node": "^2.10.0",
    "@types/node": "^26.1.2",
    "testcontainers": "^12.0.4",
    "ts-proto": "^2.12.0",
    "tsdown": "^0.23.2",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
